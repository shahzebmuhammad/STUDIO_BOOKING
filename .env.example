# Google Apps Script web app /exec URL, deployed to execute as your Google account
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/REPLACE_DEPLOYMENT_ID/exec
# Long random shared secret set in Apps Script Script Properties (never expose to browser)
GOOGLE_SHEETS_API_SECRET=replace-with-a-long-random-secret
# Long random session-signing secret, different from the Apps Script shared secret
STUDIO_SESSION_SECRET=replace-with-another-long-random-secret
